# Sanity CMS configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Sanity dataset name (e.g. production)
NEXT_PUBLIC_SANITY_DATASET=
# Sanity API date version
NEXT_PUBLIC_SANITY_API_VERSION=
# Sanity write access token
SANITY_API_WRITE_TOKEN=

# Razorpay payments
RAZORPAY_KEY_ID=
# Razorpay secret key
RAZORPAY_KEY_SECRET=
# Razorpay currency code (e.g. AUD)
RAZORPAY_CURRENCY=
# Outbound Razorpay payment notification webhook URL
RAZORPAY_PAYMENT_WEBHOOK_URL=
# Inbound Razorpay webhook signature secret
RAZORPAY_WEBHOOK_SECRET=

# Admin and GeoGuard authentication
GEO_ADMIN_PASSWORD=
# Coupons admin panel password
COUPONS_ADMIN_PASSWORD=
# Site name identifier for geo configuration
GEO_SITE_NAME=
# Secret token for internal geo whitelist API
GEO_INTERNAL_SECRET=

# Redis / KV storage
KV_REST_API_URL=
# Redis / KV auth token
KV_REST_API_TOKEN=
# Upstash Redis endpoint URL
UPSTASH_REDIS_REST_URL=
# Upstash Redis token
UPSTASH_REDIS_REST_TOKEN=

# Resend email delivery
RESEND_API_KEY=
# Sender email address for outgoing messages
RESEND_FROM_EMAIL=

# GoHighLevel CRM integration
GHL_API_KEY=
# GoHighLevel location ID
GHL_LOCATION_ID=

# Public site origin URL
NEXT_PUBLIC_SITE_URL=

# Public form submission webhooks
NEXT_PUBLIC_ENROLL_WEBHOOK_URL=
# Public trial booking webhook URL
NEXT_PUBLIC_BOOK_TRIAL_WEBHOOK_URL=
# Public contact form webhook URL
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=
# Public career application webhook URL
NEXT_PUBLIC_CAREERS_WEBHOOK_URL=
# Public piano lesson enquiry webhook URL
NEXT_PUBLIC_PIANO_ENQUIRY_WEBHOOK_URL=
# Public guitar lesson enquiry webhook URL
NEXT_PUBLIC_GUITAR_ENQUIRY_WEBHOOK_URL=
